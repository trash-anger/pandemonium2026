{
  // Worker du jeu « Déjà vu ! » (LOT-0 : étiquettes, page provisoire, admin).
  // L'identifiant de compte se passe par CLOUDFLARE_ACCOUNT_ID, pas dans le dépôt.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deja-vu",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public" },
  // Codes des étiquettes du jeu (donnees/etiquettes-jeu.csv) : importés comme texte
  "rules": [{ "type": "Text", "globs": ["**/*.csv"], "fallthrough": true }, { "type": "Data", "globs": ["**/*.png"], "fallthrough": true }],
  // Après la fête, l'ancien teaser pointe aussi ici (page de fin, dossier fin/)
  "routes": [{ "pattern": "p.uyt.re", "custom_domain": true }, { "pattern": "pandemonium2026.uyt.re", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deja-vu",
      "database_id": "a6172fc5-f157-481e-9ba8-6f95bcefbe5f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://p.uyt.re"
  },
  // LOT-3 D : tick des notifications push chaque minute ; SOI répartit les gros envois en lots (50 sous-requêtes par appel)
  "triggers": { "crons": ["* * * * *"] },
  "services": [{ "binding": "SOI", "service": "deja-vu" }],
  "dev": { "host": "localhost:8787" },
  // Aperçu des PR (GitHub Actions) : Worker et base séparés, banc d'essai actif, jamais les données de production.
  "env": {
    "apercu": {
      "name": "deja-vu-apercu",
      "routes": [],
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "deja-vu-apercu",
          "database_id": "07cafb7a-705e-47e4-9e7c-5222c212fd40",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "PUBLIC_ORIGIN": "https://deja-vu-apercu.uyt-re.workers.dev",
        "BANC": "actif"
      },
      "triggers": { "crons": ["* * * * *"] },
      "services": [{ "binding": "SOI", "service": "deja-vu-apercu" }]
    }
  },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put [--env apercu]) : GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // SESSION_SECRET, ADMIN_EMAILS, LECTEURS_EMAILS (adresses séparées par des virgules),
  // VAPID_JWK (clé privée P-256 au format JWK, notifications push ; voir README).
}
